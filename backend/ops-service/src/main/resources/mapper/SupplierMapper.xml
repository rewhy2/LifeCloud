<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiang.ops.mapper.SupplierMapper">

    <sql id="Base_Column_List">
        id, name, contact, phone, category, create_time
    </sql>

    <select id="selectAll" resultType="com.zhixiang.ops.entity.Supplier">
        SELECT <include refid="Base_Column_List"/> FROM supplier ORDER BY id ASC
    </select>

    <select id="selectById" resultType="com.zhixiang.ops.entity.Supplier">
        SELECT <include refid="Base_Column_List"/> FROM supplier WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.zhixiang.ops.entity.Supplier" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO supplier (name, contact, phone, category) VALUES (#{name}, #{contact}, #{phone}, #{category})
    </insert>

    <update id="update" parameterType="com.zhixiang.ops.entity.Supplier">
        UPDATE supplier
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="category != null">category = #{category},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM supplier WHERE id = #{id}
    </delete>
</mapper>
