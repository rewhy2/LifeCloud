<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiang.ops.mapper.InventoryMapper">

    <sql id="Base_Column_List">
        id, name, supplier_id, quantity, unit, threshold, price, create_time
    </sql>

    <select id="selectAll" resultType="com.zhixiang.ops.entity.Inventory">
        SELECT <include refid="Base_Column_List"/> FROM inventory
        <where>
            <if test="name != null and name != ''">AND name LIKE CONCAT('%', #{name}, '%')</if>
            <if test="low != null and low">AND quantity &lt; threshold</if>
        </where>
        ORDER BY id ASC
    </select>

    <select id="selectById" resultType="com.zhixiang.ops.entity.Inventory">
        SELECT <include refid="Base_Column_List"/> FROM inventory WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.zhixiang.ops.entity.Inventory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO inventory (name, supplier_id, quantity, unit, threshold, price)
        VALUES (#{name}, #{supplierId}, #{quantity}, #{unit}, #{threshold}, #{price})
    </insert>

    <update id="update" parameterType="com.zhixiang.ops.entity.Inventory">
        UPDATE inventory
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="threshold != null">threshold = #{threshold},</if>
            <if test="price != null">price = #{price},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM inventory WHERE id = #{id}
    </delete>
</mapper>
