<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiang.ops.mapper.EmployeeMapper">

    <sql id="Base_Column_List">
        id, name, role, phone, salary, create_time
    </sql>

    <select id="selectAll" resultType="com.zhixiang.ops.entity.Employee">
        SELECT <include refid="Base_Column_List"/> FROM employee ORDER BY id ASC
    </select>

    <select id="selectById" resultType="com.zhixiang.ops.entity.Employee">
        SELECT <include refid="Base_Column_List"/> FROM employee WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.zhixiang.ops.entity.Employee" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO employee (name, role, phone, salary) VALUES (#{name}, #{role}, #{phone}, #{salary})
    </insert>

    <update id="update" parameterType="com.zhixiang.ops.entity.Employee">
        UPDATE employee
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="role != null">role = #{role},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="salary != null">salary = #{salary},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM employee WHERE id = #{id}
    </delete>
</mapper>
