<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiang.ops.mapper.MemberMapper">

    <sql id="Base_Column_List">
        id, name, phone, level, point, balance, total_spend, create_time
    </sql>

    <select id="selectAll" resultType="com.zhixiang.ops.entity.Member">
        SELECT <include refid="Base_Column_List"/> FROM member
        <where>
            <if test="name != null and name != ''">AND name LIKE CONCAT('%', #{name}, '%')</if>
            <if test="level != null and level != ''">AND level = #{level}</if>
        </where>
        ORDER BY total_spend DESC
    </select>

    <select id="selectById" resultType="com.zhixiang.ops.entity.Member">
        SELECT <include refid="Base_Column_List"/> FROM member WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.zhixiang.ops.entity.Member" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member (name, phone, level, point, balance, total_spend)
        VALUES (#{name}, #{phone}, #{level}, #{point}, #{balance}, #{totalSpend})
    </insert>

    <update id="update" parameterType="com.zhixiang.ops.entity.Member">
        UPDATE member
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="level != null">level = #{level},</if>
            <if test="point != null">point = #{point},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="totalSpend != null">total_spend = #{totalSpend},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM member WHERE id = #{id}
    </delete>
</mapper>
