<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiang.ai.mapper.KnowledgeDocMapper">

    <sql id="Base_Column_List">
        id, category, title, content, create_time
    </sql>

    <select id="selectAll" resultType="com.zhixiang.ai.entity.KnowledgeDoc">
        SELECT <include refid="Base_Column_List"/> FROM knowledge_doc ORDER BY id ASC
    </select>

    <insert id="insert" parameterType="com.zhixiang.ai.entity.KnowledgeDoc" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO knowledge_doc (category, title, content) VALUES (#{category}, #{title}, #{content})
    </insert>
</mapper>
